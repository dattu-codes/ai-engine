# AI Engine Environment Configuration
# Free & Self-Hosted Developer Platform

# Application Environment (development, testing, production)
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
# In production, set a strong, unique secret key (minimum 32 characters)
JWT_SECRET=ai-engine-development-secret-key-32chars-minimum-hs256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Defaults to SQLite auth.db in local directory)
# For production PostgreSQL: postgresql://user:password@localhost:5432/ai_engine
DATABASE_URL=sqlite:///./auth.db

# Redis Cache & Background Tasks (Optional for development, recommended for production)
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration (Optional - platform falls back to offline AST static analysis)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub OAuth & Webhooks (Optional - for GitHub repository sync and PR reviews)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# File Storage Configuration
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=app/temp_clones
